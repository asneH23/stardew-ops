# Kopiera denna fil: cp .env.example .env
# Lägg ALDRIG .env i git (den är redan i .gitignore)

# GitHub Webhook Secret — generera med: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your-secret-here

# Database — Railway sätter detta automatiskt. Lokalt: lämna tomt (SQLite används)
# DATABASE_URL=sqlite:///./stardew_ops.db

# LLM-API (Fas 2, inte nödvändigt för MVP)
# GEMINI_API_KEY=your-key-here
